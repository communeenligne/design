---
// Template of every page (documentation page pattern of the package): header (icon and wordmark, search palette of
// the package by its trigger, Ctrl K, ⌘ K or /, sections, phone menu), side navigation of the section by family, breadcrumb, content, table of contents on
// the right (the part being read marked by js/toc.js), previous and next pages, licenses, footer with the theme
// switch. Not indexed. With a "main" slot (page not found), the page gives its own <main> instead of the side
// navigation, the content and the table of contents.
//
// Below the tablet breakpoint, the sections and the side navigation carry cel-hide-below-tablet and give way to the
// phone menu (cel-menu): the sections, and the pages of the current one. Without script, the menu is a list at the top
// of the page.
import '../styles/main.css'
import Icon from '../components/Icon.astro'
import { SECTIONS, SITE_NAME, breadcrumbOf, groupsOf, neighboursOf, sectionOf } from '../lib/navigation.js'
import { VERSION } from '../lib/version.js'
import { searchPalette, searchTrigger } from '../lib/search.js'

const props = Astro.props.frontmatter ?? Astro.props
const { title, description, full = false } = props
const headings = Astro.props.headings ?? props.headings ?? []
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`
const section = sectionOf(path)
const steps = breadcrumbOf(path, title)
const { previous, next } = neighboursOf(path)
const toc = headings.filter((heading) => heading.depth === 2)
const pageTitle = path === '/' ? SITE_NAME : `${title} · ${SITE_NAME}`
const sidenav = section && section.pages.length > 0
const groups = sidenav ? groupsOf(section) : []
const current = (url) => (path === url ? 'page' : path.startsWith(url) ? 'true' : undefined)
const bare = Astro.slots.has('main')
const footerColumns = SECTIONS.filter((s) => ['/getting-started/', '/foundations/'].includes(s.url))
---
<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description}>}
    <meta name="robots" content="noindex, nofollow">
    {section && <meta name="section" content={section.title}>}
    <meta name="theme-color" content="#1F3A5F">
    <link rel="icon" href="/design/brand/favicon.svg" type="image/svg+xml">
    <script is:inline src="/design/js/theme-boot.js"></script>
    <script is:inline src="/design/js/motion-boot.js"></script>
    <script is:inline type="module" src="/js/site.js"></script>
</head>
<body class="cel-page">
    <a class="cel-skip-link" href="#contenu">Aller au contenu</a>

    <header class="cel-doc-header">
        <div class="cel-container cel-doc-header__top">
            <a href="/" class="cel-doc-header__brand">
                <img class="cel-logo-light" src="/design/brand/icon.svg" alt="" width="36" height="36">
                <img class="cel-logo-dark" src="/design/brand/icon-on-dark.svg" alt="" width="36" height="36">
                <span class="cel-doc-header__name cel-wordmark"><strong>commune</strong>enligne</span>
            </a>
            <Fragment set:html={searchTrigger({ name: 'Rechercher dans le Système de Design' })} />
            <div class="cel-menu" data-cel-menu>
                <button type="button" class="cel-menu__toggle" aria-expanded="false" aria-controls="menu" aria-label="Ouvrir le menu">
                    <Icon name="bars-3" size="20" bold />
                    <span aria-hidden="true">Menu</span>
                </button>
                <div class="cel-menu__panel" id="menu" aria-labelledby="menu-title">
                    <div class="cel-menu__top">
                        <p class="cel-menu__title" id="menu-title">Menu</p>
                        <button type="button" class="cel-menu__close"><Icon name="x-mark" size="20" bold />Fermer le menu</button>
                    </div>
                    <nav aria-label="Rubriques et pages">
                        <ul class="cel-menu__list">
                            {SECTIONS.map((s) => (
                                <li>
                                    <a class="cel-menu__link" href={s.url} aria-current={current(s.url)}>{s.title}</a>
                                    {s === section && s.pages.length > 0 && (
                                        <ul class="cel-menu__sublist">
                                            <li><a href={s.url} aria-current={path === s.url ? 'page' : undefined}>Vue d'ensemble</a></li>
                                            {groupsOf(s).map((group, rank) => {
                                                const links = group.pages.map((page) => <li><a href={page.url} aria-current={path === page.url ? 'page' : undefined}>{page.title}</a></li>)

                                                return group.name
                                                    ? <li><p class="cel-menu__group" id={`menu-group-${rank}`}>{group.name}</p><ul class="cel-menu__sublist" aria-labelledby={`menu-group-${rank}`}>{links}</ul></li>
                                                    : links
                                            })}
                                        </ul>
                                    )}
                                </li>
                            ))}
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
        <nav class="cel-container cel-nav cel-doc-header__sections cel-hide-below-tablet" aria-label="Rubriques">
            <ul class="cel-nav__links">
                {SECTIONS.map((s) => <li><a href={s.url} aria-current={current(s.url)}>{s.title}</a></li>)}
            </ul>
        </nav>
    </header>

    {bare && <slot name="main" />}

    {!bare && <div class={`cel-container cel-doc-layout${sidenav ? '' : ' cel-doc-layout--no-sidenav'}${full || toc.length === 0 ? ' cel-doc-layout--no-toc' : ''}`}>
        {sidenav && (
            <nav class="cel-sidenav cel-hide-below-tablet" aria-labelledby="sidenav-title">
                <p class="cel-sidenav__title" id="sidenav-title">{section.title}</p>
                <ul>
                    <li><a href={section.url} aria-current={path === section.url ? 'page' : undefined}>Vue d'ensemble</a></li>
                </ul>
                {groups.map((group) => (
                    <>
                        {group.name && <p class="cel-sidenav__group">{group.name}</p>}
                        <ul>
                            {group.pages.map((page) => <li><a href={page.url} aria-current={path === page.url ? 'page' : undefined}>{page.title}</a></li>)}
                        </ul>
                    </>
                ))}
            </nav>
        )}

        <main id="contenu" tabindex="-1" class="cel-doc-main">
            {path !== '/' && (
                <nav class="cel-breadcrumb" aria-label="Fil d'Ariane">
                    <ol>
                        {steps.map((step, rank) => (
                            <li>
                                {rank === steps.length - 1
                                    ? <span aria-current="page">{step.title}</span>
                                    : <><a href={step.url}>{step.title}</a><span aria-hidden="true">›</span></>}
                            </li>
                        ))}
                    </ol>
                </nav>
            )}
            {path === '/'
                ? <h1 class="cel-doc-title doc-home-title" data-cel-reveal="title">Système de Design de <span class="cel-wordmark"><strong>commune</strong>enligne</span></h1>
                : <h1 class="cel-doc-title" data-cel-reveal="title">{title}</h1>}
            {description && <p class="cel-lead cel-doc-lead">{description}</p>}

            <div class="cel-doc-content">
                <slot />
            </div>

            {(previous || next) && (
                <nav class="cel-pager" aria-label="Pages voisines">
                    {previous && <a class="cel-card cel-pager__link" href={previous.url} rel="prev"><span class="cel-pager__direction">Précédent</span><span class="cel-pager__title">{previous.title}</span></a>}
                    {next && <a class="cel-card cel-pager__link cel-pager__link--next" href={next.url} rel="next"><span class="cel-pager__direction">Suivant</span><span class="cel-pager__title">{next.title}</span></a>}
                </nav>
            )}
        </main>

        {!full && toc.length > 0 && (
            <aside class="cel-toc" data-cel-toc>
                <nav aria-labelledby="toc-title">
                    <p class="cel-toc__title" id="toc-title">Sur cette page</p>
                    <ul>
                        {toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
                    </ul>
                </nav>
            </aside>
        )}
    </div>}

    <p class="doc-licenses">Code sous licence MIT · police Manrope sous licence OFL</p>

    <footer class="cel-footer">
        <div class="cel-container">
            <div class="cel-footer__links">
                <div class="cel-footer__identity">
                    <a href="/" class="cel-footer__brand"><img src="/design/brand/logo-on-dark.svg" alt="Commune en ligne, accueil du Système de Design" width="154" height="32" loading="lazy"></a>
                    <p>Le Système de Design de communeenligne : landing, centre d'aide et panel. Version {VERSION}.</p>
                </div>
                {footerColumns.map((s, rank) => (
                    <nav class="cel-footer__column" aria-labelledby={`footer-${rank}`}>
                        <p class="cel-footer__title" id={`footer-${rank}`}>{s.title}</p>
                        <ul>{s.pages.map((page) => <li><a href={page.url}>{page.title}</a></li>)}</ul>
                    </nav>
                ))}
                <nav class="cel-footer__column" aria-labelledby="footer-more">
                    <p class="cel-footer__title" id="footer-more">Et aussi</p>
                    <ul>
                        {SECTIONS.filter((s) => !footerColumns.includes(s)).map((s) => <li><a href={s.url}>{s.title}</a></li>)}
                        <li><a href="https://communeenligne.fr/" class="cel-footer__more">communeenligne.fr</a></li>
                    </ul>
                </nav>
            </div>
            <div class="cel-footer__bottom">
                <div class="cel-footer__meta">
                    <p>© 2026 · <span class="cel-footer__wordmark"><strong>commune</strong>enligne</span></p>
                </div>
                <div class="cel-theme" role="group" aria-labelledby="footer-theme" data-cel-theme hidden>
                    <span id="footer-theme">Thème :</span>
                    <span class="cel-theme__options">
                        <button type="button" class="cel-theme__option" data-cel-theme-option="light" aria-pressed="true"><Icon name="sun" />Clair</button>
                        <button type="button" class="cel-theme__option" data-cel-theme-option="dark" aria-pressed="false"><Icon name="moon" />Sombre</button>
                    </span>
                </div>
            </div>
        </div>
    </footer>
    <Fragment set:html={searchPalette({ title: 'Rechercher dans le Système de Design', placeholder: 'Composant, variable, classe…' })} />
</body>
</html>
