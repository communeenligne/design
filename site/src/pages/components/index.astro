---
import Doc from '../../layouts/Doc.astro'
import SectionIndex from '../../components/SectionIndex.astro'
import { SECTIONS } from '../../lib/navigation.js'

const section = SECTIONS.find((s) => s.url === '/components/')
---
<Doc title={section.title} description={section.description} full>
    <SectionIndex section={section} />
</Doc>
