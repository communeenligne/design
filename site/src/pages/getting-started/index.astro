---
import Doc from '../../layouts/Doc.astro'
import SectionIndex from '../../components/SectionIndex.astro'
import { RUBRIQUES } from '../../lib/navigation.js'

const rubrique = RUBRIQUES.find((r) => r.url === '/getting-started/')
---
<Doc title={rubrique.titre} description={rubrique.description} plein>
    <SectionIndex rubrique={rubrique} />
</Doc>
