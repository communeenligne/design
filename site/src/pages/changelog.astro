---
// Changelog: CHANGELOG.md of the repository, rendered at build time (a single source).
import Doc from '../layouts/Doc.astro'
import { marked } from 'marked'
import changelog from '../../../CHANGELOG.md?raw'
import { slug } from '../lib/navigation.js'

const html = marked.parse(changelog.replace(/^# .*\n/, ''))
const headings = [...changelog.matchAll(/^## (.+)$/gm)].map(([, text]) => ({ depth: 2, text, slug: slug(text) }))
const anchored = headings.reduce((page, heading) => page.replace(`<h2>${heading.text}</h2>`, `<h2 id="${heading.slug}">${heading.text}</h2>`), html)
---
<Doc title="Journal des versions" description="Ce qui change à chaque version du paquet, et la correspondance des noms pour migrer. Lu dans CHANGELOG.md du dépôt." headings={headings}>
    <Fragment set:html={anchored} />
</Doc>
