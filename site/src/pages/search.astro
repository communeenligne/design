---
// Recherche : avec script, résultats depuis search-index.json ; sans, la liste de toutes les pages.
import Doc from '../layouts/Doc.astro'
import { RUBRIQUES } from '../lib/navigation.js'
---
<Doc title="Recherche" description="Chercher une page, un composant, une variable ou une classe." plein>
    <div class="cel-pile" data-recherche>
        <form class="cel-champ" role="search" action="/search/" method="get">
            <label for="recherche-page">Mots recherchés</label>
            <input id="recherche-page" type="search" name="q" autocomplete="off">
        </form>
        <p role="status" data-etat></p>
        <ul class="doc-resultats" data-resultats></ul>
        <div data-toutes-les-pages>
            <h2 class="cel-titre-section">Toutes les pages</h2>
            {RUBRIQUES.map((rubrique) => (
                <section class="cel-pile">
                    <h3 class="cel-carte__titre"><a href={rubrique.url}>{rubrique.titre}</a></h3>
                    {rubrique.pages.length > 0 && <ul>{rubrique.pages.map((page) => <li><a href={page.url}>{page.titre}</a></li>)}</ul>}
                </section>
            ))}
        </div>
    </div>
</Doc>
