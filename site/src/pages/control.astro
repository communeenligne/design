---
// Control page, not linked in the navigation: header (with the phone menu), a section, the pricing and the footer of
// the landing, written with the classes of the package only (lib/patterns.js), to compare by eye with
// communeenligne.fr. No stylesheet of the site: only the package.
import '@communeenligne/design/index.css'
import { HEADER, SECTION, PRICING, FOOTER } from '../lib/patterns.js'

// In the footer, the theme links become the switch of js/theme.js.
const footer = FOOTER
    .replace('<div class="cel-theme" role="group"', '<div class="cel-theme" data-cel-theme role="group"')
    .replace('<a href="#" class="cel-theme__option" aria-current="true">', '<a href="#" class="cel-theme__option" data-cel-theme-option="light" aria-current="true">')
    .replace('<a href="#" class="cel-theme__option">', '<a href="#" class="cel-theme__option" data-cel-theme-option="dark">')
---
<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Contrôle de fidélité · Système de Design de communeenligne</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/design/brand/favicon.svg" type="image/svg+xml">
    <script is:inline src="/design/js/theme-boot.js"></script>
    <script is:inline src="/design/js/motion-boot.js"></script>
    <script is:inline type="module" src="/js/control.js"></script>
</head>
<body class="cel-page">
    <a class="cel-skip-link" href="#contenu">Aller au contenu</a>
    <Fragment set:html={HEADER} />
    <main id="contenu" tabindex="-1">
        <Fragment set:html={SECTION} />
        <Fragment set:html={PRICING} />
    </main>
    <Fragment set:html={footer} />
</body>
</html>
