---
// Pages of the addresses that changed (REDIRECTS in lib/navigation.js): an immediate redirection without script, and a
// link for browsers that ignore it.
import { REDIRECTS } from '../lib/navigation.js'

export const getStaticPaths = () => Object.entries(REDIRECTS).map(([from, to]) => ({ params: { redirect: from.replace(/^\/|\/$/g, '') }, props: { to } }))

const { to } = Astro.props
---
<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Page déplacée · Système de Design de communeenligne</title>
    <meta name="robots" content="noindex, nofollow">
    <meta http-equiv="refresh" content={`0; url=${to}`}>
    <link rel="canonical" href={to}>
</head>
<body>
    <p>Cette page a été déplacée : <a href={to}>{to}</a>.</p>
</body>
</html>
