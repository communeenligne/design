---
// Rules of use in two columns: what to do, what to avoid. Each rule may hold inline HTML (code, links).
import Icon from './Icon.astro'

const { dos = [], donts = [] } = Astro.props
---
<div class="cel-dos-donts">
    <section class="cel-dos-donts__column" aria-label="À faire">
        <p class="cel-dos-donts__title"><Icon name="check" size="20" bold />À faire</p>
        <ul>{dos.map((rule) => <li set:html={rule} />)}</ul>
    </section>
    <section class="cel-dos-donts__column cel-dos-donts__column--dont" aria-label="À éviter">
        <p class="cel-dos-donts__title"><Icon name="x-mark" size="20" bold />À éviter</p>
        <ul>{donts.map((rule) => <li set:html={rule} />)}</ul>
    </section>
</div>
