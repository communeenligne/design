---
// Contrasts of a component, computed at build time from the foundations (never copied), in both themes.
// pairs: [foreground, background, threshold], color names without the cel-color- prefix (or full names).
import { contrast, tokens, resolve } from '../lib/tokens.js'

const { pairs = [] } = Astro.props
const fullName = (name) => (name.startsWith('cel-') ? name : `cel-color-${name}`)
const rows = pairs.map(([foreground, background, threshold = 4.5]) => {
    const [light, dark] = ['light', 'dark'].map((mode) => contrast(resolve(tokens, fullName(foreground), mode), resolve(tokens, fullName(background), mode)))

    return { foreground, background, threshold, light, dark }
})
const format = (ratio) => `${ratio.toFixed(2).replace('.', ',')}:1`
---
<div class="cel-table-scroll">
    <table class="cel-table doc-contrasts">
        <caption>Contrastes calculés depuis les couleurs du paquet</caption>
        <thead><tr><th scope="col">Premier plan</th><th scope="col">Fond</th><th scope="col">Clair</th><th scope="col">Sombre</th><th scope="col">Seuil</th></tr></thead>
        <tbody>
            {rows.map((row) => (
                <tr>
                    <td><code>--{fullName(row.foreground)}</code></td>
                    <td><code>--{fullName(row.background)}</code></td>
                    <td>{format(row.light)} {row.light >= row.threshold ? '✓' : '✗ écart connu'}</td>
                    <td>{format(row.dark)} {row.dark >= row.threshold ? '✓' : '✗ écart connu'}</td>
                    <td>{String(row.threshold).replace('.', ',')}:1</td>
                </tr>
            ))}
        </tbody>
    </table>
</div>
