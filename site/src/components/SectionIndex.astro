---
// Pages of a section as tiles, by family when the section has some: a preview (the component itself, or the icon of
// the page), the title (the only link, which covers the tile), the summary.
import Icon from './Icon.astro'
import { PREVIEWS } from '../lib/previews.js'
import { groupsOf, slug } from '../lib/navigation.js'

const { section } = Astro.props
---
{groupsOf(section).map((group) => (
    <>
        {group.name && <h2 class="doc-group-title" id={slug(group.name)}>{group.name}</h2>}
        <ul class="cel-tiles">
            {group.pages.map((page) => {
                const preview = PREVIEWS[page.url]
                // Under a family title, the tile titles are one level below.
                const Title = group.name ? 'h3' : 'h2'

                return (
                    <li>
                        <article class="cel-tile">
                            {preview
                                ? <div class={`cel-tile__preview cel-tile__preview--${preview.background ?? 'muted'}${preview.full ? ' cel-tile__preview--full' : ''}`} aria-hidden="true" inert set:html={preview.html} />
                                : <div class="cel-tile__preview cel-tile__preview--icon" aria-hidden="true"><span class="cel-tile__pictogram"><Icon name={page.icon ?? 'squares-2x2'} size="28" /></span></div>}
                            <div class="cel-tile__body">
                                <Title class="cel-tile__title"><a class="cel-tile__link" href={page.url}>{page.title}</a></Title>
                                <p class="cel-tile__summary">{page.description}</p>
                            </div>
                            <Icon name="arrow-right" size="18" bold class="cel-tile__arrow" />
                        </article>
                    </li>
                )
            })}
        </ul>
    </>
))}
