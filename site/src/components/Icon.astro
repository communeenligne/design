---
// Icon of the package sprite (copied to /design/icons/sprite.svg). Decorative: hidden from screen readers.
import { SPRITE } from '../lib/version.js'

const { name, size, bold = false, class: className = '' } = Astro.props
const classes = ['cel-icon', size && `cel-icon--${size}`, bold && 'cel-icon--bold', className].filter(Boolean).join(' ')
---
<svg class={classes} aria-hidden="true" focusable="false"><use href={`${SPRITE}#${name}`} /></svg>
