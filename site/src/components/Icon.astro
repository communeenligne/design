---
// Icône de la planche du paquet (copiée dans /design/icons/sprite.svg). Décorative : masquée aux lecteurs d'écran.
import { ICONES } from '../lib/version.js'

const { nom, taille, appuyee = false, class: classe = '' } = Astro.props
const classes = ['cel-icone', taille && `cel-icone--${taille}`, appuyee && 'cel-icone--appuyee', classe].filter(Boolean).join(' ')
---
<svg class={classes} aria-hidden="true" focusable="false"><use href={`${ICONES}#${nom}`} /></svg>
