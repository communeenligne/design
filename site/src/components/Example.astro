---
// Live example: the rendering, then the HTML code to copy and, if any, the Tailwind version (rendered too, with the
// Tailwind theme of the package). background: page, muted, strong, deep or full (surface to set the example on; full:
// edge to edge).
import Code from './Code.astro'
import { dedent } from '../lib/code.js'

const { title, html, tailwind, background = 'page', note } = Astro.props
---
<figure class="cel-example">
    {title && <figcaption class="cel-example__title">{title}</figcaption>}
    {note && <p class="cel-example__note">{note}</p>}
    <div class={`cel-example__preview cel-example__preview--${background}`} set:html={dedent(html)} />
    <details class="cel-example__code" open>
        <summary>Code HTML</summary>
        <Code code={html} />
    </details>
    {tailwind && (
        <details class="cel-example__code">
            <summary>Version Tailwind</summary>
            <div class={`cel-example__preview cel-example__preview--${background}`} set:html={dedent(tailwind)} />
            <Code code={tailwind} />
        </details>
    )}
</figure>
