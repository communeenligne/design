---
// Démonstration vivante : le rendu, puis le code HTML à copier et, s'il existe, la version en classes Tailwind (rendue
// elle aussi, avec le thème Tailwind du paquet). fond : page, clair, fort ou profond (surface sur laquelle poser
// l'exemple).
import Code from './Code.astro'
import { desindenter } from '../lib/code.js'

const { titre, html, tailwind, fond = 'page', note } = Astro.props
const rendu = desindenter(html)
---
<figure class="doc-exemple">
    {titre && <figcaption class="doc-exemple__titre">{titre}</figcaption>}
    {note && <p class="doc-exemple__note">{note}</p>}
    <div class={`doc-exemple__rendu doc-exemple__rendu--${fond}`} set:html={rendu} />
    <details class="doc-exemple__code" open>
        <summary>Code HTML</summary>
        <Code code={html} />
    </details>
    {tailwind && (
        <details class="doc-exemple__code">
            <summary>Version Tailwind</summary>
            <div class={`doc-exemple__rendu doc-exemple__rendu--${fond}`} set:html={desindenter(tailwind)} />
            <Code code={tailwind} />
        </details>
    )}
</figure>
