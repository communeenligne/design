---
// Demonstration page of the help center (/patterns/help-center/…/): the package stylesheet and scripts only, no
// stylesheet of the site, to check that the package alone reproduces the mockups. Not indexed.
import '@communeenligne/design/index.css'

const { title } = Astro.props
---
<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title} · Démonstration du centre d'aide</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/design/brand/favicon.svg" type="image/svg+xml">
    <script is:inline src="/design/js/theme-boot.js"></script>
    <script is:inline src="/design/js/motion-boot.js"></script>
    <script is:inline type="module" src="/js/help-center.js"></script>
</head>
<body class="cel-page">
    <a class="cel-skip-link" href="#contenu">Aller au contenu</a>
    <slot />
</body>
</html>
